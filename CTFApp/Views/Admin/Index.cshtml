<div class="container mt-4">
    <h1 class="text-center mb-4">Cookie Clicker Admin Panel</h1>

    <!-- Import Section -->
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title">Import User Updates</h2>
            <form id="importForm" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="fileInput" class="form-label">Upload JSON File</label>
                    <input type="file" class="form-control" id="fileInput" name="file" accept=".json" required>
                </div>
                <button type="submit" class="btn btn-primary">Import</button>
            </form>
            <div id="response" class="mt-3"></div>
        </div>
    </div>

    <!-- Export Section -->
    <div class="card">
        <div class="card-body">
            <h2 class="card-title">Export Users</h2>
            <button id="exportButton" class="btn btn-success">Download Users JSON</button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/gameSetting.js"></script>
}